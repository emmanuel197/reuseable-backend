{
  "name": "@reuseablebackend/api",
  "version": "0.0.0",
  "private": true,
  "description": "The deployable modular-monolith NestJS app that composes @reuseablebackend/* components.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@reuseablebackend/secrets": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
